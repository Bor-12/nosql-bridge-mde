bridge TypedProductBridge {
    source MongoDB {
        database "shop"
        collection "products"
    }

    target DynamoDB {
        table "Products"
        partitionKey "id"
        sortKey "createdAt"
    }

    sourceTypes {
        _id string
        price string | integer | decimal
        stock string | integer
        createdAt timestamp
    }

    nulls preserve

    mapping {
        _id -> id using toString
        name -> name
        price -> price using toDecimal
        stock -> stock using toInteger
        createdAt -> createdAt using toString
    }
}