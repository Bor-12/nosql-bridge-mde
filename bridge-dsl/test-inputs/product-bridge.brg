bridge ProductBridge {
    source MongoDB {
        technology "DynamoDB"
        database "shop"
        collection "products"
    }

    target DynamoDB {
        
        table "Products"
        partitionKey "id"
    }

    unmapped drop

    mapping {
        _id -> id

        name -> name
        price -> price
        stock -> stock

        category.name -> category

        brand -> details.brand

        dimensions.width -> dimensions.width

        supplier.name -> manufacturer.name
    }
}
