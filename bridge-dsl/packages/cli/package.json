{
    "name": "bridge-cli",
    "description": "CLI and DSL compiler for NoSQL Bridge MDE",
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "files": [
        "bin/cli.js",
        "dist/cli.js",
        "THIRD_PARTY_NOTICES.txt"
    ],
    "bin": {
        "brg": "./bin/cli.js"
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out dist",
        "build": "node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "test": "vitest run",
        "coverage": "npm run build --prefix ../.. && vitest run --coverage",
        "prepack": "npm run build --prefix ../..",
        "test:package": "npm run build --prefix ../.. && node test/package-smoke.mjs"
    },
    "dependencies": {},
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Bor-12/nosql-bridge-mde.git",
        "directory": "bridge-dsl/packages/cli"
    },
    "devDependencies": {
        "bridge-language": "1.0.0",
        "chalk": "~5.6.2",
        "commander": "~15.0.0",
        "langium": "~4.4.0",
        "esbuild": "0.28.2",
        "vitest": "~4.1.10"
    }
}
