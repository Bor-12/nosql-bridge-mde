{
    "name": "vscode-bridge-dsl",
    "private": true,
    "description": "The extension specific package",
    "version": "1.0.0",
    "displayName": "bridge-dsl",
    "type": "module",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "bridge",
            "aliases": ["Bridge", "bridge"],
            "extensions": [".brg"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "bridge",
            "scopeName": "source.bridge",
            "path": "syntaxes/bridge.tmLanguage.json"
        }]
    },
    "activationEvents": [
        "onLanguage:bridge"
    ],
    "main": "./out/extension/main.cjs",
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out syntaxes",
        "vscode:prepublish": "npm run build",
        "build:prepare": "shx mkdir -p ./syntaxes/ && shx cp -f ../language/syntaxes/bridge.tmLanguage.json ./syntaxes/bridge.tmLanguage.json",
        "build": "npm run build:prepare && tsc -b tsconfig.json && node esbuild.mjs",
        "build:clean": "npm run clean && npm run build",
        "watch": "npm run build:prepare && concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\""
    },
    "dependencies": {
        "bridge-language": "1.0.0",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0"
    },
    "devDependencies": {
        "@types/vscode": "~1.91.0",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2"
    },
    "vsce": {
      "dependencies": false
    }
}
