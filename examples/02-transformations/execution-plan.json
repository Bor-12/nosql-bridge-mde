{
  "bridgeName": "ProductTransformationBridge",
  "source": {
    "technology": "mongodb",
    "collection": "products"
  },
  "target": {
    "technology": "dynamodb",
    "table": "Products",
    "partitionKey": "id"
  },
  "mappings": [
    {
      "source": "_id",
      "target": "id"
    },
    {
      "source": "name",
      "target": "productName"
    },
    {
      "source": "price",
      "target": "price",
      "transformation": "toNumber"
    },
    {
      "source": "status",
      "target": "status",
      "default": "ACTIVE"
    }
  ]
}
